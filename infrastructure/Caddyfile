{$SITE_ADDRESS} {
    encode zstd gzip
    request_body {
        max_size 110MB
    }
    basic_auth {
        {$REVIEW_USERNAME} {$REVIEW_PASSWORD_HASH}
    }
    reverse_proxy frontend:3000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
