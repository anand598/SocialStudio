APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://app:app_password@localhost:5432/social_content
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_VISION_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120
LOCAL_STORAGE_PATH=../storage
MAX_UPLOAD_SIZE_MB=15
# Blank uses the frontend proxy; set an explicit URL only for a separate browser-facing API.
NEXT_PUBLIC_API_URL=
API_PROXY_URL=http://127.0.0.1:8000

# ollama is the default. demo explicitly uses deterministic copy, with real rendering.
GENERATION_MODE=ollama
FFMPEG_TIMEOUT_SECONDS=180
STALE_JOB_SECONDS=900
REQUESTS_PER_MINUTE=10
# Optional TrueType font path; DejaVu/Arial is discovered automatically.
FONT_PATH=
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=2200
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=60s
MAX_VIDEO_UPLOAD_SIZE_MB=100
MAX_SOURCE_VIDEO_SECONDS=180
URL_FETCH_TIMEOUT_SECONDS=10
URL_MAX_REDIRECTS=3
# Set true when served over HTTPS so the job-owner cookie is Secure.
COOKIE_SECURE=false
# Optional background music for video outputs (MP3/M4A/WAV); users must hold the rights.
MAX_MUSIC_UPLOAD_SIZE_MB=20
MAX_MUSIC_SECONDS=600
